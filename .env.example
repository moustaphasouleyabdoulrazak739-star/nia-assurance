# Copiez ce fichier en `.env` et renseignez vos propres valeurs.
# Ne committez jamais le fichier `.env` (il est ignoré par git).

# Clé secrète Django, OBLIGATOIRE (aucune valeur par défaut dans settings.py).
# Générez-en une : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Mode debug (True en local, False en production). Si absent : False.
# En DEBUG=True, ALLOWED_HOSTS ci-dessous est ignoré (nécessaire pour que
# l'app mobile Expo joigne le backend via son IP LAN, qui change à chaque
# réseau — voir mobile/src/api/config.js).
DEBUG=True

# Domaines/IP autorisés en production (DEBUG=False), séparés par des virgules.
# Sans effet en DEBUG=True. Si absent : localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Durée HSTS en secondes, UNIQUEMENT une fois le HTTPS en place et stable
# (voir l'audit — à activer en dernier). 0 ou absent = désactivé.
SECURE_HSTS_SECONDS=0

# Base de données PostgreSQL
DB_NAME=nia_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
