# Copiez ce fichier en `.env` et renseignez vos propres valeurs.
# Ne committez jamais le fichier `.env` (il est ignoré par git).

# Clé secrète Django — générez-en une : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changez-moi

# Mode debug (True en local, False en production)
DEBUG=True

# Base de données PostgreSQL
DB_NAME=nia_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
